    "max_mem_host_gb": 64,
    "max_mem_device_gb": 8,
    "psf_file_paths": [],
    "save_psf": true,
    "labeled_image": "",
    "label_psf_map": "",
    "output_compression": "none",
    "output_compression_level": -1,
    "tile_width": 0,
    "tile_length": 0
  }
